+    GPIO_DIR_WRITE(5, (uint8_t)(KB_C18_P5_0 | KB_C19_P5_1 | KB_C20_P5_2));
+    GPIO_DIR_WRITE(6, (uint8_t)(LED_R0_P6_0 | LED_R1_P6_1 | LED_R2_P6_2 | LED_R3_P6_3 | LED_R4_P6_4 | LED_R5_P6_5));
+
+    GPIO_PULLUP_WRITE(5, (uint8_t)(KB_R4_P5_3 | KB_R5_P5_4));
+    GPIO_PULLUP_WRITE(7, (uint8_t)(KB_R0_P7_0 | KB_R1_P7_1 | KB_R2_P7_2 | KB_R3_P7_3));
+
+    GPIO_WRITE(1, (uint8_t)(KB_C0_P1_4 | KB_C1_P1_5 | KB_C14_P1_3 | KB_C15_P1_2 | KB_C16_P1_1 | KB_C17_P1_0));
+    GPIO_WRITE(2, (uint8_t)(KB_C2_P2_0 | KB_C3_P2_1 | KB_C4_P2_2 | KB_C5_P2_3 | KB_C6_P2_4 | KB_C7_P2_5));
+    GPIO_WRITE(3, (uint8_t)(KB_C8_P3_0 | KB_C9_P3_1 | KB_C10_P3_2 | KB_C11_P3_3 | KB_C12_P3_4 | KB_C13_P3_5));
+    GPIO_WRITE(5, (uint8_t)(KB_C18_P5_0 | KB_C19_P5_1 | KB_C20_P5_2));
+    GPIO_WRITE(6, LED_R0_P6_0 | LED_R1_P6_1 | LED_R2_P6_2 | LED_R3_P6_3 | LED_R4_P6_4 | LED_R5_P6_5);
