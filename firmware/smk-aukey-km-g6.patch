+
+void user_gpio_init()
+{
+    DRVCON = DRVCON_UNLOCK_P1;
+    P1DRV  = GPIO_DRIVE_25MA;
+
+    DRVCON = DRVCON_UNLOCK_P2;
+    P2DRV  = GPIO_DRIVE_25MA;
+
+    DRVCON = DRVCON_UNLOCK_P3;
+    P3DRV  = GPIO_DRIVE_25MA;
+
+    DRVCON = DRVCON_UNLOCK_P5;
+    P5DRV  = GPIO_DRIVE_25MA;
+
+    DRVCON = DRVCON_LOCK;
+
+    /* Latch off before enabling outputs; preserve unrelated P0 pins. */
+    GPIO_HIGH(0, LED_LOCK_MASK);
+    GPIO_PULLUP_ON(0, LED_LOCK_MASK);
+    GPIO_OUTPUT(0, LED_LOCK_MASK);
+    GPIO_DIR_WRITE(1, (uint8_t)(KB_C0_P1_4 | KB_C1_P1_5 | KB_C14_P1_3 | KB_C15_P1_2 | KB_C16_P1_1 | KB_C17_P1_0));
