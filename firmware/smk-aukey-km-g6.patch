new file mode 100644
index 0000000..c349a81
--- /dev/null
+++ b/src/smk/host_lighting.c
@@ -0,0 +1,81 @@
+#include "host_lighting.h"
+#include "report.h"
+
+#ifdef HOST_LIGHTING_ENABLE
+
+#include "kbdef.h"
+
+#define HOST_LIGHTING_KEYS ((uint8_t)(MATRIX_ROWS * MATRIX_COLS))
+
+enum host_lighting_command {
+    HOST_LIGHTING_SET_CHUNK = 1,
+    HOST_LIGHTING_FILL      = 2,
+    HOST_LIGHTING_SET_ACTIVE = 3,
+};
+
+static __xdata uint8_t frame[MATRIX_ROWS][MATRIX_COLS];
+static uint8_t active;
+static uint8_t reply[HOST_LIGHTING_REPORT_SIZE] = {
+    REPORT_ID_LIGHTING, HOST_LIGHTING_VERSION, 0,
+    MATRIX_ROWS, MATRIX_COLS, HOST_LIGHTING_KEYS, 3, 0
+};
+
+bool host_lighting_is_active(void)
+{
+    return active != 0;
+}
+
+uint8_t host_lighting_get(uint8_t row, uint8_t col)
+{
+    if (row >= MATRIX_ROWS || col >= MATRIX_COLS) {
+        return 0;
+    }
+    return frame[row][col];
+}
+
+void host_lighting_set_report(const uint8_t *report)
+{
+    uint8_t command;
+    uint8_t offset;
+    uint8_t count;
+
+    if (report[0] != REPORT_ID_LIGHTING || report[1] != HOST_LIGHTING_VERSION) {
+        return;
+    }
+
+    command = report[2];
+    offset  = report[3];
+    count   = report[4];
+
+    if (command == HOST_LIGHTING_SET_CHUNK) {
+        if (count == 0 || count > 3 || offset >= HOST_LIGHTING_KEYS ||
+            (uint16_t)offset + count > HOST_LIGHTING_KEYS) {
+            return;
+        }
+        for (uint8_t i = 0; i < count; i++) {
+            ((__xdata uint8_t *)frame)[offset + i] = report[5 + i];
+        }
+    } else if (command == HOST_LIGHTING_FILL) {
+        for (uint8_t i = 0; i < HOST_LIGHTING_KEYS; i++) {
+            ((__xdata uint8_t *)frame)[i] = report[5];
+        }
+    } else if (command == HOST_LIGHTING_SET_ACTIVE) {
+        active = report[5] ? 1 : 0;
+        reply[2] = active;
+    }
+}
+
+uint8_t *host_lighting_get_report(void)
+{
+    reply[2] = active;
+    return reply;
+}
+
+#else
+
+bool host_lighting_is_active(void) { return false; }
+uint8_t host_lighting_get(uint8_t row, uint8_t col) { row; col; return 0; }
+void host_lighting_set_report(const uint8_t *report) { report; }
+uint8_t *host_lighting_get_report(void) { return 0; }
+
+#endif
