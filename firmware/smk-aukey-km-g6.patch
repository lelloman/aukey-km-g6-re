diff --git a/src/keyboards/aukey-km-g6/layouts/default/indicators.c b/src/keyboards/aukey-km-g6/layouts/default/indicators.c
new file mode 100644
index 0000000..8aeecf0
--- /dev/null
+++ b/src/keyboards/aukey-km-g6/layouts/default/indicators.c
@@ -0,0 +1,245 @@
+#include "indicators.h"
+#include "sh68f90.h"
+#include "kbdef.h"
+#include "gpio.h"
+#include "pwm.h"
+#include "settings.h"
+#include "led_effect.h"
+#include "user_led.h"
+#include "host_lighting.h"
+
+#define LED_ROWS MATRIX_ROWS
+#define LED_COLS MATRIX_COLS
+
+#define LED_PHASE_SPEED 4
+
+/* Stock 0x2BEC / 0x6DF4: clock selector 7, channel start bit 3.
+ * Preserve the observed control bytes without guessing their frequency. */
+#define STOCK_PWM_BLANK 0x87
+#define STOCK_PWM_LIT   0x8f
+#define SET_STOCK_PWM(channel, value) do { \
+    uint8_t intensity = (value); \
+    if (intensity) { \
+        channel##CON = STOCK_PWM_LIT; \
+        SET_PWM_DUTY(channel, (uint16_t)0, (uint16_t)intensity); \
+    } \
+} while (0)
+/* Expand LED_PWM_Cn aliases before token pasting. */
+#define SET_LED_PWM(channel, value) SET_STOCK_PWM(channel, value)
+
+#define LED_ALL_ROWS (uint8_t)(LED_R0_P6_0 | LED_R1_P6_1 | LED_R2_P6_2 | LED_R3_P6_3 | LED_R4_P6_4 | LED_R5_P6_5)
+
+#include LED_GEOMETRY_HEADER
+_Static_assert(LED_GEOMETRY_ROWS == LED_ROWS && LED_GEOMETRY_COLS == LED_COLS, "generated LED geometry size does not match the key matrix");
+
+static uint8_t led_fb[LED_ROWS][LED_COLS];
+
+static uint8_t led_row;
+static uint8_t led_phase;
+static uint8_t regen_row;
+static uint8_t regen_col;
+
+void        indicators_pwm_enable();
+void        indicators_pwm_disable();
+static void led_regen_one();
+static void led_enable_row();
+static void led_set_columns();
+
+void indicators_start()
+{
+    led_row   = 0;
+    led_phase = 0;
+    regen_row = 0;
+    regen_col = 0;
+
+    user_settings.led_effect = FX_RADIAL;
+    settings_load();
+    if (user_settings.led_effect > FX_OFF) {
+        user_settings.led_effect = FX_RADIAL;
+    }
+
+    indicators_pwm_disable();
+}
+
+void indicators_next_effect()
+{
+    if (++user_settings.led_effect > FX_OFF) {
+        user_settings.led_effect = 0;
+    }
+
+    settings_save();
+}
+
+void indicators_factory_reset()
+{
+    user_settings.led_effect = FX_RADIAL;
+    settings_save();
+}
+
+void indicators_pre_update()
+{
+    GPIO_HIGH(6, LED_ALL_ROWS);
+
+    indicators_pwm_disable();
+}
+
+bool indicators_update_step(keyboard_state_t *keyboard, uint8_t current_step)
+{
+    current_step;
+
+    /* Host HID LED bits, independent of the backlight effect or frame. */
+    LED_NUM = !(keyboard->led_state & (1 << 0));
+    LED_CAPS = !(keyboard->led_state & (1 << 1));
+    LED_SCROLL = !(keyboard->led_state & (1 << 2));
+
+    if (!host_lighting_is_active() && user_settings.led_effect >= FX_OFF) {
+        return false;
+    }
+
+    if (!host_lighting_is_active()) led_regen_one();
+
+    led_set_columns();
+    led_enable_row();
+
+    if (++led_row >= LED_ROWS) {
+        led_row = 0;
+    }
+
+    return led_row == 0;
+}
+
+void indicators_post_update()
+{
+    /* Channels are started individually while programming the row. */
+}
+
+static void led_regen_one()
+{
+    uint8_t v;
+    if (led_effect_mono((led_effect_t)user_settings.led_effect, regen_row, regen_col, led_phase, &v)) {
+        led_fb[regen_row][regen_col] = v;
+    }
+
+    if (++regen_col >= LED_COLS) {
+        regen_col = 0;
+        if (++regen_row >= LED_ROWS) {
+            regen_row = 0;
+            led_phase = (uint8_t)(led_phase + LED_PHASE_SPEED);
+        }
+    }
+}
+
+static void led_enable_row()
+{
+    switch (led_row) {
+        case 0:
+            LED_R0 = 0;
+            break;
+        case 1:
+            LED_R1 = 0;
+            break;
+        case 2:
+            LED_R2 = 0;
+            break;
+        case 3:
+            LED_R3 = 0;
+            break;
+        case 4:
+            LED_R4 = 0;
+            break;
+        case 5:
+            LED_R5 = 0;
+            break;
+    }
+}
+
+static void led_set_columns()
+{
+    __xdata uint8_t *fb = led_fb[led_row];
+
+    if (host_lighting_is_active()) {
+        SET_LED_PWM(LED_PWM_C0, host_lighting_get(led_row, 0));
+        SET_LED_PWM(LED_PWM_C1, host_lighting_get(led_row, 1));
+        SET_LED_PWM(LED_PWM_C2, host_lighting_get(led_row, 2));
+        SET_LED_PWM(LED_PWM_C3, host_lighting_get(led_row, 3));
+        SET_LED_PWM(LED_PWM_C4, host_lighting_get(led_row, 4));
+        SET_LED_PWM(LED_PWM_C5, host_lighting_get(led_row, 5));
+        SET_LED_PWM(LED_PWM_C6, host_lighting_get(led_row, 6));
+        SET_LED_PWM(LED_PWM_C7, host_lighting_get(led_row, 7));
+        SET_LED_PWM(LED_PWM_C8, host_lighting_get(led_row, 8));
+        SET_LED_PWM(LED_PWM_C9, host_lighting_get(led_row, 9));
+        SET_LED_PWM(LED_PWM_C10, host_lighting_get(led_row, 10));
+        SET_LED_PWM(LED_PWM_C11, host_lighting_get(led_row, 11));
+        SET_LED_PWM(LED_PWM_C12, host_lighting_get(led_row, 12));
+        SET_LED_PWM(LED_PWM_C13, host_lighting_get(led_row, 13));
+        SET_LED_PWM(LED_PWM_C14, host_lighting_get(led_row, 14));
+        SET_LED_PWM(LED_PWM_C15, host_lighting_get(led_row, 15));
+        SET_LED_PWM(LED_PWM_C16, host_lighting_get(led_row, 16));
+        SET_LED_PWM(LED_PWM_C17, host_lighting_get(led_row, 17));
+        SET_LED_PWM(LED_PWM_C18, host_lighting_get(led_row, 18));
+        SET_LED_PWM(LED_PWM_C19, host_lighting_get(led_row, 19));
+        SET_LED_PWM(LED_PWM_C20, host_lighting_get(led_row, 20));
+        return;
+    }
+
+    SET_LED_PWM(LED_PWM_C0, fb[0]);
+    SET_LED_PWM(LED_PWM_C1, fb[1]);
+    SET_LED_PWM(LED_PWM_C2, fb[2]);
+    SET_LED_PWM(LED_PWM_C3, fb[3]);
+    SET_LED_PWM(LED_PWM_C4, fb[4]);
+    SET_LED_PWM(LED_PWM_C5, fb[5]);
+    SET_LED_PWM(LED_PWM_C6, fb[6]);
+    SET_LED_PWM(LED_PWM_C7, fb[7]);
+    SET_LED_PWM(LED_PWM_C8, fb[8]);
+    SET_LED_PWM(LED_PWM_C9, fb[9]);
+    SET_LED_PWM(LED_PWM_C10, fb[10]);
+    SET_LED_PWM(LED_PWM_C11, fb[11]);
+    SET_LED_PWM(LED_PWM_C12, fb[12]);
+    SET_LED_PWM(LED_PWM_C13, fb[13]);
+    SET_LED_PWM(LED_PWM_C14, fb[14]);
+    SET_LED_PWM(LED_PWM_C15, fb[15]);
+    SET_LED_PWM(LED_PWM_C16, fb[16]);
+    SET_LED_PWM(LED_PWM_C17, fb[17]);
+    SET_LED_PWM(LED_PWM_C18, fb[18]);
+    SET_LED_PWM(LED_PWM_C19, fb[19]);
+    SET_LED_PWM(LED_PWM_C20, fb[20]);
+}
+
+void indicators_pwm_enable()
+{
+    /* Matrix scanning must not restart channels or select an LED row. */
+}
+
+void indicators_pwm_disable()
+{
+    GPIO_HIGH(6, LED_ALL_ROWS);
+    // TODO: try abstracting individual banks away
+    PWM00CON = STOCK_PWM_BLANK;
+    PWM01CON = STOCK_PWM_BLANK;
+    PWM02CON = STOCK_PWM_BLANK;
+    PWM03CON = STOCK_PWM_BLANK;
+    PWM04CON = STOCK_PWM_BLANK;
+    PWM05CON = STOCK_PWM_BLANK;
+
+    PWM10CON = STOCK_PWM_BLANK;
+    PWM11CON = STOCK_PWM_BLANK;
+    PWM12CON = STOCK_PWM_BLANK;
+    PWM13CON = STOCK_PWM_BLANK;
+    PWM14CON = STOCK_PWM_BLANK;
+    PWM15CON = STOCK_PWM_BLANK;
+
+    PWM20CON = STOCK_PWM_BLANK;
+    PWM21CON = STOCK_PWM_BLANK;
+    PWM22CON = STOCK_PWM_BLANK;
+    PWM23CON = STOCK_PWM_BLANK;
+    PWM24CON = STOCK_PWM_BLANK;
+    PWM25CON = STOCK_PWM_BLANK;
+    PWM40CON = STOCK_PWM_BLANK;
+    PWM41CON = STOCK_PWM_BLANK;
+    PWM42CON = STOCK_PWM_BLANK;
+    /* Stock clears the shared column latches after disabling channels. */
+    GPIO_LOW(1, 0x3f);
+    GPIO_LOW(2, 0x3f);
+    GPIO_LOW(3, 0x3f);
+    GPIO_LOW(5, 0x07);
+}
